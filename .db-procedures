create or replace procedure residencias.check_role_permission(
    in p_role_id bigint,
    in p_module_name varchar(20),
    in p_permission_name varchar(50)
)
begin
    declare has_permission int default 0;

    select 1 into has_permission
    from residencias.roles_modules_permissions rmp
    join residencias.modules m on rmp.module_id = m.id
    join residencias.permissions p on rmp.permission_id = p.id
    where rmp.role_id = p_role_id
      and m.module_name = p_module_name
      and p.permission = p_permission_name
      and rmp.is_granted = 1
    limit 1;

    select has_permission as granted;
end;


