create or replace procedure residencias.assign_permissions_to_role(
    in p_role_id bigint,
    in p_permissions_json json
)
begin
    declare v_module_id bigint;
    declare v_is_visible tinyint;
    declare v_permission_id bigint;
    declare i int default 0;
    declare j int default 0;
    declare v_modules_length int;
    declare v_perms_length int;

    if not exists (select 1 from residencias.roles where id = p_role_id) then
        signal sqlstate '45000' set message_text = 'role not found';
    end if;

    start transaction;

    delete from residencias.roles_modules_permissions where role_id = p_role_id;
    delete from residencias.roles_modules where role_id = p_role_id;

    set v_modules_length = json_length(p_permissions_json);

    while i < v_modules_length do
        set v_module_id = json_unquote(json_extract(p_permissions_json, concat('$[', i, '].module_id')));
        set v_is_visible = json_unquote(json_extract(p_permissions_json, concat('$[', i, '].is_visible')));

        insert into residencias.roles_modules (role_id, module_id, is_visible)
        values (p_role_id, v_module_id, ifnull(v_is_visible, 0));

        set v_perms_length = ifnull(json_length(json_extract(p_permissions_json, concat('$[', i, '].permissions'))), 0);
        set j = 0;

        while j < v_perms_length do
            set v_permission_id = json_unquote(json_extract(p_permissions_json, concat('$[', i, '].permissions[', j, ']')));

            insert into residencias.roles_modules_permissions (role_id, module_id, permission_id, is_granted)
            values (p_role_id, v_module_id, v_permission_id, 1);

            set j = j + 1;
        end while;

        set i = i + 1;
    end while;

    commit;

    select 'permissions assigned successfully' as message;
end;

create or replace procedure residencias.get_permissions_for_role(
    in p_role_id bigint
)
begin
    if not exists (select 1 from residencias.roles where id = p_role_id) then
        signal sqlstate '45000' set message_text = 'role not found';
    end if;

    select
        p_role_id as role_id,
        (select role_name from residencias.roles where id = p_role_id) as role_name,
        m.id as module_id,
        m.module_name,
        p.id as permission_id,
        p.permission as permission,
        p.permission as permission_name,
        ifnull(rmp.is_granted, 0) as is_granted,
        ifnull(rm.is_visible, 0) as is_visible
    from
        residencias.modules m
    cross join
        residencias.permissions p
    left join
        residencias.roles_modules_permissions rmp
            on rmp.role_id = p_role_id and rmp.module_id = m.id and rmp.permission_id = p.id
    left join
        residencias.roles_modules rm
            on rm.role_id = p_role_id and rm.module_id = m.id
    order by
        m.module_name, p.permission;
end;


