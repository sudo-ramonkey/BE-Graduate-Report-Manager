-- El orden de los parametros debe coincidir con el CALL de
-- repositories/reports.repository.js. p_work_area faltaba aqui aunque el
-- repositorio siempre lo envio: la llamada mandaba un argumento de mas y
-- MariaDB rechazaba todas las altas de reporte.
create or replace procedure residencias.create_report(
    in p_student_name varchar(100),
    in p_control_number varchar(15),
    in p_major varchar(100),
    in p_report_title varchar(255),
    in p_work_area varchar(100),
    in p_pdf_route varchar(500),
    in p_company_id bigint,
    in p_semester_id bigint,
    in p_keywords_json json,
    out p_report_id bigint
)
begin
    declare i int default 0;
    declare v_json_length int;
    declare v_keyword_id bigint;

    if p_student_name is null or trim(p_student_name) = '' then
        signal sqlstate '45000' set message_text = 'student name cannot be empty';
    end if;

    if exists (select 1 from residencias.reports where control_number = p_control_number) then
        signal sqlstate '45000' set message_text = 'control number already exists';
    end if;

    start transaction;

    insert into residencias.reports(student_name, control_number, major, report_title, work_area, pdf_route, company_id, semester_id)
    values (p_student_name, p_control_number, p_major, p_report_title, p_work_area, p_pdf_route, p_company_id, p_semester_id);

    set p_report_id = last_insert_id();

    if p_keywords_json is not null and json_valid(p_keywords_json) and json_length(p_keywords_json) > 0 then
        set v_json_length = json_length(p_keywords_json);
        while i < v_json_length do
            set v_keyword_id = json_unquote(json_extract(p_keywords_json, concat('$[', i, ']')));

            insert into residencias.reports_keywords (report_id, keyword_id)
            values (p_report_id, v_keyword_id);

            set i = i + 1;
        end while;
    end if;

    commit;
end;

create or replace procedure residencias.get_reports()
begin
    select
        r.id,
        r.student_name,
        r.control_number,
        r.major,
        r.report_title,
        r.work_area,
        r.pdf_route,
        r.company_id,
        c.company_name,
        r.semester_id,
        s.semester,
        -- Dos columnas y no una: el frontend muestra los nombres pero necesita
        -- los ids para reabrir el reporte en el formulario de edicion. Antes
        -- solo salian los nombres bajo la clave "keywords", y al editar se
        -- enviaban esos nombres como si fueran ids.
        (select json_arrayagg(k.keyword)
         from residencias.reports_keywords rk
         join residencias.keywords k on rk.keyword_id = k.id
         where rk.report_id = r.id) as keyword_names,
        (select json_arrayagg(rk.keyword_id)
         from residencias.reports_keywords rk
         where rk.report_id = r.id) as keyword_ids
    from
        residencias.reports r
    join
        residencias.companies c on r.company_id = c.id
    join
        residencias.semester s on r.semester_id = s.id;
end;

-- Igual que create_report: el orden debe coincidir con el CALL de
-- repositories/reports.repository.js. Faltaban p_major, p_work_area y
-- p_pdf_route, asi que el repositorio enviaba ocho argumentos a un
-- procedimiento de seis y ninguna edicion de reporte llegaba a guardarse.
create or replace procedure residencias.update_report(
    in p_report_id bigint,
    in p_student_name varchar(100),
    in p_major varchar(100),
    in p_report_title varchar(255),
    in p_work_area varchar(100),
    in p_company_id bigint,
    in p_semester_id bigint,
    in p_pdf_route varchar(500),
    in p_keywords_json json
)
begin
    declare i int default 0;
    declare v_json_length int;
    declare v_keyword_id bigint;

    start transaction;

    update residencias.reports
    set
        student_name = p_student_name,
        major = p_major,
        report_title = p_report_title,
        work_area = p_work_area,
        company_id = p_company_id,
        semester_id = p_semester_id,
        -- Solo se reemplaza la ruta si se subio un archivo nuevo. Editar un
        -- reporte sin tocar el PDF debe conservar el que ya tenia.
        pdf_route = ifnull(p_pdf_route, pdf_route)
    where id = p_report_id;

    delete from residencias.reports_keywords where report_id = p_report_id;

    if p_keywords_json is not null and json_valid(p_keywords_json) and json_length(p_keywords_json) > 0 then
        set v_json_length = json_length(p_keywords_json);
        while i < v_json_length do
            set v_keyword_id = json_unquote(json_extract(p_keywords_json, concat('$[', i, ']')));
            insert into residencias.reports_keywords (report_id, keyword_id)
            values (p_report_id, v_keyword_id);
            set i = i + 1;
        end while;
    end if;

    commit;
    select p_report_id as id;
end;

create or replace procedure residencias.delete_report(
    in p_report_id bigint
)
begin
    delete from residencias.reports where id = p_report_id;
    select 'report deleted successfully' as message;
end;


create or replace procedure residencias.get_reports_by_keyword(
    in p_keyword varchar(30)
)
begin
    select r.id,
           r.student_name,
           r.control_number,
           r.major,
           r.report_title,
           r.pdf_route,
           r.company_id,
           r.semester_id
    from residencias.reports r
    join residencias.reports_keywords rk on r.id = rk.report_id
    join residencias.keywords k on rk.keyword_id = k.id
    where k.keyword = p_keyword;
end;


